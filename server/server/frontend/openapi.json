          },
          "completed_clients": {
            "type": "integer",
            "format": "int64"
          },
          "failed_clients": {
            "type": "integer",
            "format": "int64"
          },
          "group_id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "running_clients": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "total_clients": {
            "type": "integer",
            "format": "int64"
