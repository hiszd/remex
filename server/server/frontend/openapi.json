            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Client": {
        "type": "object",
        "required": [
          "id",
          "secret",
          "client_name",
          "hardware_hash",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "client_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "hardware_hash": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ClientJobStatusResponse": {
        "type": "object",
        "required": [
          "client_id",
          "client_name",
          "status",
          "execution_count"
