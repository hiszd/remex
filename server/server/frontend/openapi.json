        "type": "object",
        "required": [
          "client_id",
          "client_name",
          "status"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ClientWithGroups": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ClientSRV"
          },
          {
            "type": "object",
            "required": [
              "group_ids"
            ],
            "properties": {
              "group_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "CreateClientForm": {
        "type": "object",
        "required": [
          "client_name",
          "hardware_hash"
        ],
        "properties": {
          "client_name": {
            "type": "string"
          },
          "hardware_hash": {
            "type": "string"
          }
        }
      },
      "CreateGroupForm": {
        "type": "object",
        "required": [
          "group_name"
        ],
        "properties": {
          "client_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "group_name": {
            "type": "string"
          }
        }
      },
