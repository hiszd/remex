        "type": "object",
        "required": [
          "job_name",
          "job_type",
          "job_status",
          "job_shell",
          "job_command"
        ],
        "properties": {
          "frequency": {
            "type": [
              "string",
              "null"
            ]
          },
          "group_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "job_command": {
            "type": "string"
          },
          "job_name": {
            "type": "string"
          },
          "job_shell": {
            "type": "string"
          },
          "job_status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "job_type": {
            "type": "string"
          },
          "scheduled_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Group": {
        "type": "object",
        "required": [
          "id",
          "group_name",
          "created_at",
          "updated_at",
          "client_count"
        ],
        "properties": {
          "client_count": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "group_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GroupJobPath": {
        "type": "object",
        "required": [
          "group_id",
          "job_id"
        ],
        "properties": {
          "group_id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          }
        }
      },
      "GroupJobStatusMetadata": {
        "type": "object",
        "required": [
          "client_statuses",
          "total_clients",
          "completed_clients",
          "failed_clients",
          "running_clients"
