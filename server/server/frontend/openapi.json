          "client_statuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientStatusSummary"
            }
          },
          "completed_clients": {
            "type": "integer",
            "format": "int64"
          },
          "failed_clients": {
            "type": "integer",
            "format": "int64"
          },
          "running_clients": {
            "type": "integer",
            "format": "int64"
          },
          "total_clients": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GroupJobStatusResponse": {
        "type": "object",
        "required": [
          "group_id",
          "job_id",
          "status",
          "client_statuses",
          "total_clients",
          "completed_clients",
          "failed_clients",
          "running_clients"
        ],
        "properties": {
          "client_statuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientStatusSummary"
