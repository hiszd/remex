        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "execution_count": {
            "type": "integer",
            "format": "int64"
          },
          "latest_execution_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "latest_execution_timestamp": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ClientSRV": {
        "type": "object",
        "required": [
          "id",
          "secret",
          "client_name",
          "hardware_hash",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "client_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "hardware_hash": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
