          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "hardware_hash": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
